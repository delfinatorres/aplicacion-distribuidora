<Window x:Class="Aplicacion_Distribuidora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Ventas - Distribuidora Elsa María"
        Icon="favicon.ico"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        >

    <Grid Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#313244">
            <TextBlock x:Name="TxtBienvenida"
                       Foreground="#CDD6F4"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Grid>

        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <Button x:Name="BtnPedidos"
                    Content="📋 Pedidos"
                    Width="140" Height="90"
                    Margin="15" FontSize="18"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnPedidos_Click"/>

            <Button x:Name="BtnClientes"
                    Content="👤 Clientes"
                    Width="140" Height="90" FontSize="18"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClientes_Click"/>

            <Button x:Name="BtnStock"
                    Content="📦 Stock"
                    Width="140" Height="90"
                    Margin="15" FontSize="18"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnStock_Click"/>
            <Button x:Name="BtnPagos"
                    Content="💰 Pagos"
                    Width="140" Height="90"
                    FontSize="18"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnPagos_Click"/>

            <Button x:Name="BtnReportes"
                    Content="📊 Reportes"
                    Width="140" Height="90"
                    Margin="15" FontSize="18"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnReportes_Click"/>

        </WrapPanel>
    </Grid>
</Window>
