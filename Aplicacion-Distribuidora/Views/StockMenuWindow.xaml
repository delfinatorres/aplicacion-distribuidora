<Window x:Class="Aplicacion_Distribuidora.Views.StockMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock - Distribuidora Elsa María"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#1E1E2E" Margin="30">
        <StackPanel VerticalAlignment="Center">

            <!-- Título -->
            <TextBlock Text="Módulo de Stock"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#CBA6F7"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Botón Registrar Producto -->
            <Button x:Name="BtnRegistrarProducto"
                    Content="📦 Registrar Producto"
                    Height="70"
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnRegistrarProducto_Click"/>

            <!-- Botón Consultar Stock -->
            <Button x:Name="BtnConsultarStock"
                    Content="🔍 Consultar Stock"
                    Height="70"
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnConsultarStock_Click"/>

            <!-- Botón Volver -->
            <Button x:Name="BtnVolver"
                    Content="← Volver"
                    Height="45"
                    Margin="0,10,0,0"
                    FontSize="14"
                    Background="#F38BA8"
                    Foreground="#1E1E2E"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnVolver_Click"/>

        </StackPanel>
    </Grid>
</Window>
