<Window x:Class="Aplicacion_Distribuidora.Views.HistorialPedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Pedidos - Distribuidora Elsa María"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E2E" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Historial de Pedidos"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#CBA6F7"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Filtros -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBuscarCliente"
                     Grid.Column="0"
                     Height="40" Padding="10"
                     FontSize="14"
                     Background="#313244"
                     Foreground="#CDD6F4"
                     BorderBrush="#CBA6F7"
                     BorderThickness="1"
                     Margin="0,0,10,0"
                     Text="Buscar por cliente..."/>

            <ComboBox x:Name="CmbFiltroEstado"
                      Grid.Column="1"
                      Height="40"
                      FontSize="14"
                      Background="#313244"
                      Foreground="#CDD6F4"
                      BorderBrush="#CBA6F7"
                      BorderThickness="1"
                      Margin="0,0,10,0">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Registrado"/>
                <ComboBoxItem Content="EnPreparacion"/>
                <ComboBoxItem Content="EnDistribucion"/>
                <ComboBoxItem Content="Entregado"/>
                <ComboBoxItem Content="Cancelado"/>
            </ComboBox>

            <Button x:Name="BtnFiltrar"
                    Grid.Column="2"
                    Content="Filtrar"
                    Height="40"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#CBA6F7"
                    Foreground="#1E1E2E"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnFiltrar_Click"/>
        </Grid>

        <!-- Tabla de pedidos -->
        <DataGrid Grid.Row="2"
                  x:Name="DgPedidos"
                  Background="#313244"
                  Foreground="#CDD6F4"
                  BorderBrush="#CBA6F7"
                  BorderThickness="1"
                  RowBackground="#313244"
                  AlternatingRowBackground="#45475A"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#CBA6F7"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="N° Pedido" Binding="{Binding Id}" Width="90"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre}" Width="150"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                <DataGridTextColumn Header="Forma de Pago" Binding="{Binding FormaDePago}" Width="130"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=\{0:C\}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>