<Window x:Class="Aplicacion_Distribuidora.Views.PagosMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagos - Distribuidora Elsa María"
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#1E1E2E" Margin="30">
        <StackPanel VerticalAlignment="Center">

            <!-- Título -->
            <TextBlock Text="Módulo de Pagos"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#CBA6F7"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Botón Registrar Pago -->
            <Button x:Name="BtnRegistrarPago"
                    Content="💰 Registrar Pago"
                    Height="70"
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnRegistrarPago_Click"/>

            <!-- Botón Consultar Cuentas Corrientes -->
            <Button x:Name="BtnCuentasCorrientes"
                    Content="📒 Consultar Cuentas Corrientes"
                    Height="70"
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#313244"
                    Foreground="#CDD6F4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCuentasCorrientes_Click"/>

            <!-- Botón Volver -->
            <Button x:Name="BtnVolver"
                    Content="← Volver"
                    Height="45"
                    Margin="0,10,0,0"
                    FontSize="14"
                    Background="#F38BA8"
                    Foreground="#1E1E2E"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnVolver_Click"/>

        </StackPanel>
    </Grid>
</Window>