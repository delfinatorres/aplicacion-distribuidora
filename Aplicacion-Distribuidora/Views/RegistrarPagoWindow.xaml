<Window x:Class="Aplicacion_Distribuidora.Views.RegistrarPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Pago - Distribuidora Elsa María"
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#1E1E2E" Margin="30">
        <StackPanel>

            <!-- Título -->
            <TextBlock Text="Registrar Pago"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#CBA6F7"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Número de pedido -->
            <TextBlock Text="Número de Pedido" Foreground="#CDD6F4" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtNumeroPedido"
                         Grid.Column="0"
                         Height="40" Padding="10"
                         FontSize="14"
                         Background="#313244"
                         Foreground="#CDD6F4"
                         BorderBrush="#CBA6F7"
                         BorderThickness="1"
                         Margin="0,0,10,0"/>

                <Button x:Name="BtnBuscar"
                        Grid.Column="1"
                        Content="Buscar"
                        Height="40"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#CBA6F7"
                        Foreground="#1E1E2E"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnBuscar_Click"/>
            </Grid>

            <!-- Info del pedido -->
            <Border x:Name="PanelInfo"
                    Background="#313244"
                    BorderBrush="#CBA6F7"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,15"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtInfoCliente"
                               Foreground="#CDD6F4"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtInfoTotal"
                               Foreground="#A6E3A1"
                               FontSize="16"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Método de pago -->
            <TextBlock Text="Método de Pago" Foreground="#CDD6F4" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbMetodoPago"
                      Height="40"
                      FontSize="14"
                      Background="#313244"
                      Foreground="#CDD6F4"
                      BorderBrush="#CBA6F7"
                      BorderThickness="1"
                      Margin="0,0,0,25">
                <ComboBoxItem Content="Efectivo"/>
                <ComboBoxItem Content="Transferencia"/>
            </ComboBox>

            <!-- Botones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnRegistrar"
                        Content="Registrar Pago"
                        Grid.Column="0"
                        Height="45"
                        Margin="0,0,10,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#CBA6F7"
                        Foreground="#1E1E2E"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnRegistrar_Click"/>

                <Button x:Name="BtnCancelar"
                        Content="Cancelar"
                        Grid.Column="1"
                        Height="45"
                        Margin="10,0,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#F38BA8"
                        Foreground="#1E1E2E"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCancelar_Click"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
