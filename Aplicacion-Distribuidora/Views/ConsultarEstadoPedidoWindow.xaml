<Window x:Class="Aplicacion_Distribuidora.Views.ConsultarEstadoPedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consultar Estado de Pedido - Distribuidora Elsa María"
        Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#1E1E2E" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Consultar Estado de Pedido"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#CBA6F7"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Buscador -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtNumeroPedido"
                     Grid.Column="0"
                     Height="40" Padding="10"
                     FontSize="14"
                     Background="#313244"
                     Foreground="#CDD6F4"
                     BorderBrush="#CBA6F7"
                     BorderThickness="1"
                     Margin="0,0,10,0"/>

            <Button x:Name="BtnBuscar"
                    Grid.Column="1"
                    Content="Buscar"
                    Height="40"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#CBA6F7"
                    Foreground="#1E1E2E"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnBuscar_Click"/>
        </Grid>

        <!-- Info del pedido -->
        <StackPanel Grid.Row="2"
                    x:Name="PanelInfo"
                    Visibility="Collapsed"
                    Margin="0,0,0,20">

            <Border Background="#313244"
                    BorderBrush="#CBA6F7"
                    BorderThickness="1"
                    Padding="15">
                <StackPanel>
                    <TextBlock x:Name="TxtNroPedido"
                               Foreground="#CBA6F7"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtCliente"
                               Foreground="#CDD6F4"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtFecha"
                               Foreground="#CDD6F4"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtFormaPago"
                               Foreground="#CDD6F4"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtTipoEntrega"
                               Foreground="#CDD6F4"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtEstado"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtTotal"
                               Foreground="#A6E3A1"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Productos del pedido -->
        <DataGrid Grid.Row="3"
                  x:Name="DgDetalles"
                  Visibility="Collapsed"
                  Background="#313244"
                  Foreground="#CDD6F4"
                  BorderBrush="#CBA6F7"
                  BorderThickness="1"
                  RowBackground="#313244"
                  AlternatingRowBackground="#45475A"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#CBA6F7"/>
                    <Setter Property="Foreground" Value="#1E1E2E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto.Nombre}" Width="200"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitario, StringFormat=\{0:C\}}" Width="120"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=\{0:C\}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>